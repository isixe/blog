.tea
  font-size 0.8125em
  color #999999
  margin-top 10px

.reward-container
  display flex
  flex-direction column
  align-items center
  margin-top 50px
  cursor pointer

.reward-img-container
  display none
  margin-top 20px
  opacity 0
  transition opacity 2s ease

.reward-img
  width 200px
  margin 10px
  border 1px dashed #ccc
  border-radius 4px
  padding 10px

.singleImgContainer
  width 50%
  height 240px

.wechatPay,
.aliPay
  text-align center
  font-size 0.8125em
  color #999999